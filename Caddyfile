# CADDY_DOMAIN defaults to zibs.app in compose.yaml.
# Caddy obtains and renews the TLS certificate after public DNS and ports 80/443
# point to this host.
{$CADDY_DOMAIN} {
	encode zstd gzip

	# Grafana externally shared dashboards use this page, its deliberately
	# anonymous dashboard API, and these public static assets. Do not proxy the
	# broader Grafana UI or its general /api surface.
	@public_grafana path /public-dashboards/* /api/public/dashboards/* /public/build/* /public/img/* /favicon.ico
	handle @public_grafana {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy zibs:8080
	}
}
