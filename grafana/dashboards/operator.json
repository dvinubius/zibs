    {
      "id": 7,
      "title": "Request count by route and status",
      "description": "Completed requests per rolling interval. Route labels are private diagnostic data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (increase(zibs_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Response count by status",
      "description": "Generic 404s include requests that were not short-link follows.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(zibs_http_requests_total[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Request latency (normal range)",
      "description": "Rolling average, p50, and p95, visually capped so isolated slow requests do not obscure normal work. Inspect the slow-request panel and private logs for durations above the cap. p99 is intentionally omitted at this traffic volume.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(zibs_http_request_duration_seconds_sum[$__rate_interval])) / sum(rate(zibs_http_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "average"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(zibs_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(zibs_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 29,
      "title": "In-flight requests",
      "description": "Current application requests being handled at scrape time. Use to investigate sustained work; it is not a throughput measure. Fast requests commonly complete between 30-second scrapes.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zibs_http_in_flight_requests",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "text": {
          "valueSize": 64
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
