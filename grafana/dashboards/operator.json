          "expr": "zibs_db_in_use_connections",
          "legendFormat": "in use"
        },
        {
          "refId": "C",
          "expr": "zibs_db_idle_connections",
          "legendFormat": "idle"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
