    {
      "id": 16,
      "title": "Expiry cleanup duration",
      "description": "P95 of successful expiry-cleanup runs over the trailing 30 days.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
