    {
      "id": 31,
      "title": "Database operation duration",
      "description": "Rolling average and p95 per bounded store operation. These database timings exclude HTTP parsing and response work; use the request-latency panel and private logs for end-to-end diagnosis.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(zibs_db_operation_duration_seconds_sum[$__rate_interval])) / sum by (operation) (rate(zibs_db_operation_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{operation}} average"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(zibs_db_operation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{operation}} p95"
        }
      ]
    },
    {
      "id": 32,
      "title": "Database errors by operation and kind",
      "description": "Rolling database errors. Error kinds are bounded to busy, constraint, and other; expected not-found and invalid outcomes are not database errors. No data commonly means no database-error series has been created yet; verify the metric after deployment before treating it as a clean state.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, kind) (increase(zibs_db_errors_total[$__rate_interval]))",
          "legendFormat": "{{operation}} {{kind}}"
        }
      ]
    },
