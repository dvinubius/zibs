{
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "uid": "zibs-traffic-synthetic",
  "title": "zibs synthetic activity",
  "description": "Requests marked by the synthetic traffic generator.",
  "tags": [
    "zibs",
    "operator",
    "traffic"
  ],
  "version": 1,
  "panels": [
    {
      "id": 100,
      "title": "Overview",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Requests in selected period",
      "description": "All completed application requests in the dashboard time range.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(zibs_http_requests_total{traffic_class=\"synthetic\"}[$__range])) or vector(0)",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8F9BA8"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Successful redirects in selected period",
      "description": "Short-link follows that found an active link and returned HTTP 302.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(zibs_link_operations_total{operation=\"follow\",result=\"success\",traffic_class=\"synthetic\"}[$__range])) or vector(0)",
          "legendFormat": "redirects"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#74BE69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Link misses in selected period",
      "description": "Attempted short-link follows with no active matching link; unrelated HTTP 404s are excluded.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(zibs_link_operations_total{operation=\"follow\",result=\"not_found\",traffic_class=\"synthetic\"}[$__range])) or vector(0)",
          "legendFormat": "link misses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8F9BA8"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "5xx responses in selected period",
      "description": "Open the bounded private Loki query to inspect completed requests classified as server errors in this dashboard time range.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(zibs_http_requests_total{status=~\"5..\",traffic_class=\"synthetic\"}[$__range])) or vector(0)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8F9BA8"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 50,
      "title": "Links created in selected period",
      "description": "Successful link creations attributed to this request class.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(zibs_link_operations_total{operation=\"create\",result=\"success\",traffic_class=\"synthetic\"}[$__range])) or vector(0)",
          "legendFormat": "redirects"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#74BE69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 51,
      "title": "Manual deletions in selected period",
      "description": "Successful manual deletions attributed to this request class.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(zibs_link_operations_total{operation=\"delete\",result=\"success\",traffic_class=\"synthetic\"}[$__range])) or vector(0)",
          "legendFormat": "link misses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8F9BA8"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 101,
      "title": "Requests and latency",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "title": "Request count by route and status",
      "description": "Completed requests per rolling interval. Route labels are private diagnostic data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (increase(zibs_http_requests_total{traffic_class=\"synthetic\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Response count by status",
      "description": "Generic 404s include requests that were not short-link follows.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(zibs_http_requests_total{traffic_class=\"synthetic\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Request latency",
      "description": "Rolling average, p50, and p95. The y-axis scales to the slowest value in view, so at low traffic one slow request can dominate; widen the range before reading a spike. The request-log panel below shows each request's duration_ms. p99 is intentionally omitted at this traffic volume.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(zibs_http_request_duration_seconds_sum{traffic_class=\"synthetic\"}[$__rate_interval])) / sum(rate(zibs_http_request_duration_seconds_count{traffic_class=\"synthetic\"}[$__rate_interval]))",
          "legendFormat": "average"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(zibs_http_request_duration_seconds_bucket{traffic_class=\"synthetic\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(zibs_http_request_duration_seconds_bucket{traffic_class=\"synthetic\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 102,
      "title": "Link operations",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "title": "Link operation count",
      "description": "Product operations per rolling interval, separate from generic HTTP status outcomes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, result) (increase(zibs_link_operations_total{traffic_class=\"synthetic\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{result}}"
        }
      ]
    },
    {
      "id": 104,
      "title": "Request logs",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 22,
      "title": "Recent classified requests",
      "description": "Private request logs for this traffic class. Raw paths remain private.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"zibs\"} | json | event=\"request_completed\" | traffic_class=\"synthetic\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
