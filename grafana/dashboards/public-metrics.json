{
  "uid": "zibs-public-metrics",
  "title": "zibs public metrics",
  "description": "Aggregated service metrics only. Do not add logs, dashboard variables, annotations, raw paths, short codes, or destination URLs.",
  "tags": ["zibs", "public"],
  "timepicker": {"hidden": true},
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 5,
  "time": {"from": "now-24h", "to": "now"},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Requests (last 24h)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(increase(zibs_http_requests_total[$__range]))", "legendFormat": "requests"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#8F9BA8"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "none", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "id": 2,
      "title": "Successful redirects",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum(increase(zibs_link_operations_total{operation=\"follow\",result=\"success\"}[24h])) or vector(0)", "legendFormat": "24h"},
        {"refId": "B", "expr": "sum(increase(zibs_link_operations_total{operation=\"follow\",result=\"success\"}[7d])) or vector(0)", "legendFormat": "7d"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#74BE69"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 3,
      "title": "Links created",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum(increase(zibs_link_operations_total{operation=\"create\",result=\"success\"}[24h])) or vector(0)", "legendFormat": "24h"},
        {"refId": "B", "expr": "sum(increase(zibs_link_operations_total{operation=\"create\",result=\"success\"}[7d])) or vector(0)", "legendFormat": "7d"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#8F9BA8"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "none", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 4,
      "title": "Service up",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"refId": "A", "expr": "min(up{job=\"zibs\"})", "legendFormat": "up"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 5,
      "title": "Response count by status (last 24h)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"refId": "A", "expr": "sum by (status) (increase(zibs_http_requests_total[$__rate_interval]))", "legendFormat": "HTTP {{status}}"}]
    },
    {
      "id": 6,
      "title": "Request latency (last 24h)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"refId": "A", "expr": "sum(rate(zibs_http_request_duration_seconds_sum[$__rate_interval])) / sum(rate(zibs_http_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "average"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(zibs_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 7,
      "title": "Active links",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "zibs_active_links"}],
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#74BE69"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    }
  ]
}
